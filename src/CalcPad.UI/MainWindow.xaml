<Window x:Class="CalcPad.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:CalcPad.UI.Converters"
        mc:Ignorable="d"
        Title="计算稿纸" 
        Height="700" Width="500"
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding IsTopmost}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Window.Resources>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- 顶部标题栏 -->
            <RowDefinition Height="*"/>       <!-- 主内容区 -->
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180" MaxWidth="350"/>  <!-- 左侧变量面板 -->
            <ColumnDefinition Width="*"/>                                  <!-- 右侧主内容区 -->
        </Grid.ColumnDefinitions>

        <!-- 顶部标题栏（横跨左右两列） -->
        <materialDesign:ColorZone Grid.Row="0" Grid.ColumnSpan="2"
                                  Mode="PrimaryMid" 
                                  Padding="15,12"
                                  Style="{StaticResource CustomColorZone}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>    <!-- 标题占据剩余空间 -->
                    <ColumnDefinition Width="Auto"/> <!-- 按钮区域 -->
                </Grid.ColumnDefinitions>

                <!-- 标题文本 - 左对齐并填满可用空间 -->
                <TextBlock Grid.Column="0"
                          Text="计算稿纸" 
                          FontSize="20" 
                          FontWeight="Bold"
                          Foreground="White"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,0"/>

                <!-- 右侧按钮区域 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignToolButton}" 
                            ToolTip="设置"
                            Click="SettingsButton_Click"
                            Foreground="White"
                            Margin="0,0,5,0">
                        <materialDesign:PackIcon Kind="Settings" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" 
                            ToolTip="清空历史"
                            Command="{Binding ClearHistoryCommand}"
                            Foreground="White"
                            Margin="0,0,5,0">
                        <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" 
                            ToolTip="切换主题"
                            Command="{Binding ToggleThemeCommand}"
                            Foreground="White"
                            Margin="0,0,5,0">
                        <materialDesign:PackIcon Kind="ThemeLightDark" Width="20" Height="20"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignToolButton}" 
                            ToolTip="{Binding TopmostTooltip}"
                            Command="{Binding ToggleTopmostCommand}"
                            Foreground="White"
                            Margin="0,0,0,0">
                        <materialDesign:PackIcon Kind="{Binding TopmostIcon}" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- 左侧：变量面板 -->
        <Border Grid.Row="1" Grid.Column="0"
                Margin="10,10,8,10"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="{StaticResource RadiusLarge}"
                Padding="12"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.25" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 变量面板标题 -->
                <TextBlock Grid.Row="0"
                          Text="已定义变量"
                          FontSize="{StaticResource FontSizeMedium}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,12"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <!-- 变量工具栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="变量列表" 
                              FontSize="{StaticResource FontSizeSmall}" 
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <Button Content="清空变量" 
                            Style="{StaticResource SecondaryFlatButton}"
                            Command="{Binding ClearVariablesCommand}"/>
                </StackPanel>

                <!-- 变量列表 -->
                <ListView Grid.Row="2"
                          ItemsSource="{Binding Variables}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="VariableItem_MouseDoubleClick"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                          Text="{Binding Name}" 
                                          FontWeight="Medium"
                                          FontSize="{StaticResource FontSizeSmall}"
                                          Foreground="{DynamicResource PrimaryHueMidBrush}"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" 
                                          Text="=" 
                                          FontSize="{StaticResource FontSizeSmall}"
                                          Foreground="Gray"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" 
                                          Text="{Binding Value, StringFormat=G15}" 
                                          FontSize="{StaticResource FontSizeSmall}"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          VerticalAlignment="Center"/>
                                
                                <!-- 删除按钮 -->
                                <Button Grid.Column="3"
                                       Style="{StaticResource MaterialDesignToolButton}"
                                       ToolTip="删除此变量"
                                       Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                       CommandParameter="{Binding Name}"
                                       Padding="{StaticResource SpacingSmall}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Height="24">
                                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="IndianRed" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 右侧：主内容区 -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>     <!-- 公式和结果显示区 -->
                <RowDefinition Height="Auto"/>    <!-- 输入区 -->
                <RowDefinition Height="*"/>       <!-- 历史记录 -->
                <RowDefinition Height="Auto"/>    <!-- 设置面板 -->
            </Grid.RowDefinitions>

        <!-- 公式和结果显示区 -->
        <Border Grid.Row="0" 
                Margin="12" 
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="{StaticResource RadiusLarge}"
                Padding="24"
                BorderBrush="#1FFFFFFF"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.25" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 公式显示 -->
                <TextBlock Grid.Row="0"
                          Text="{Binding CurrentExpression}" 
                          FontSize="{StaticResource FontSizeTitle}" 
                          Foreground="{DynamicResource MaterialDesignBody}"
                          TextWrapping="Wrap"
                          Margin="0,0,0,16"
                          TextAlignment="Right"
                          MinHeight="30"/>
                
                <!-- 结果分隔线 -->
                <Border Grid.Row="1"
                       Height="1" 
                       Background="{DynamicResource MaterialDesignDivider}" 
                       Margin="0,0,0,16"/>
                
                <!-- 结果显示和复制按钮 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- 结果显示 -->
                    <TextBlock Grid.Column="0"
                              FontSize="36" 
                              FontWeight="Bold"
                              Foreground="{Binding ResultColor}"
                              TextAlignment="Right">
                        <Run Text="= " Foreground="Gray"/>
                        <Run Text="{Binding CurrentResult}"/>
                    </TextBlock>
                    
                    <!-- 复制按钮 -->
                    <Button Grid.Column="1"
                           Style="{StaticResource MaterialDesignToolButton}"
                           ToolTip="复制结果"
                           Click="CopyResultButton_Click"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Padding="8">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 输入区 -->
        <materialDesign:Card Grid.Row="1" 
                             Margin="12,0,12,10"
                             Padding="16">
            <materialDesign:Card.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.25" Direction="270"/>
            </materialDesign:Card.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 输入框 -->
                <TextBox x:Name="InputTextBox" Grid.Column="0"
                        Text="{Binding InputExpression, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource CalcInputBox}"
                        materialDesign:HintAssist.Hint="输入计算公式..."
                        KeyDown="InputBox_KeyDown"/>

                <!-- 计算按钮 -->
                <Button Grid.Column="1"
                        Content="计算"
                        Margin="12,0,0,0"
                        Style="{StaticResource PrimaryActionButton}"
                        Command="{Binding CalculateCommand}"/>
            </Grid>
        </materialDesign:Card>

        <!-- 历史记录列表 -->
        <materialDesign:Card Grid.Row="2" 
                             Margin="12,0,12,12"
                             Padding="12">
            <materialDesign:Card.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.25" Direction="270"/>
            </materialDesign:Card.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 历史记录标题 -->
                <TextBlock Grid.Row="0"
                          Text="历史记录"
                          FontSize="{StaticResource FontSizeMedium}"
                          FontWeight="SemiBold"
                          Margin="0,0,0,12"
                          Foreground="{DynamicResource MaterialDesignBody}"/>

                <!-- 历史记录列表 -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding HistoryRecords}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="HistoryList_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0,6"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 公式和结果 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Expression}" 
                                              FontWeight="Medium"
                                              FontSize="{StaticResource FontSizeMedium}"
                                              Margin="0,0,0,4"/>
                                    <TextBlock FontSize="{StaticResource FontSizeSmall}">
                                        <Run Text="= " Foreground="Gray"/>
                                        <Run Text="{Binding Result}" 
                                            Foreground="{Binding IsError, Converter={StaticResource BoolToBrushConverter}}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 时间 -->
                                <TextBlock Grid.Column="1"
                                          Text="{Binding CreatedAt, StringFormat='HH:mm'}"
                                          FontSize="11"
                                          Foreground="Gray"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </materialDesign:Card>

        <!-- 设置面板 -->
        <Expander Grid.Row="3"
                  x:Name="SettingsExpander"
                  Header="设置"
                  Margin="12,8,12,12"
                  Background="{DynamicResource MaterialDesignCardBackground}"
                  Visibility="Collapsed">
            <Border Padding="15" Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel>
                    <!-- 自动清空输入框选项 -->
                    <CheckBox Content="计算后自动清空输入框"
                             IsChecked="{Binding AutoClearInput}"
                             FontSize="{StaticResource FontSizeLarge}"
                             Margin="0,0,0,12"
                             ToolTip="启用后，每次计算成功会自动清空输入框，防止误操作影响变量"/>
                    
                    <TextBlock Text="启用此选项可以避免手动删除输入框内容时意外触发计算，导致变量被错误更新。"
                              FontSize="{StaticResource FontSizeSmall}"
                              Foreground="Gray"
                              TextWrapping="Wrap"
                              Margin="0,0,0,8"/>
                </StackPanel>
            </Border>
        </Expander>
        </Grid>
    </Grid>
</Window>
