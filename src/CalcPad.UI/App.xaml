<Application x:Class="CalcPad.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 使用深青色主题 - 专业精密工具感 -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Teal" SecondaryColor="Orange" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                
                <!-- 自定义样式优化 -->
                <ResourceDictionary>
                    <!-- 标题栏背景色 - 深青色渐变 -->
                    <Style x:Key="CustomColorZone" TargetType="materialDesign:ColorZone" BasedOn="{StaticResource {x:Type materialDesign:ColorZone}}">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0D9488" Offset="0"/>
                                    <GradientStop Color="#14B8A6" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    
                    <!-- ===== 统一间距系统 (8px Grid) ===== -->
                    <!-- 内边距 -->
                    <Thickness x:Key="SpacingTiny">4</Thickness>
                    <Thickness x:Key="SpacingSmall">8</Thickness>
                    <Thickness x:Key="SpacingMedium">12</Thickness>
                    <Thickness x:Key="SpacingLarge">16</Thickness>
                    <Thickness x:Key="SpacingXLarge">24</Thickness>
                    <Thickness x:Key="SpacingXXLarge">32</Thickness>
                    
                    <!-- 圆角 -->
                    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
                    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
                    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
                    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
                    
                    <!-- 字体大小 -->
                    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
                    <sys:Double x:Key="FontSizeMedium">14</sys:Double>
                    <sys:Double x:Key="FontSizeLarge">16</sys:Double>
                    <sys:Double x:Key="FontSizeXLarge">18</sys:Double>
                    <sys:Double x:Key="FontSizeXXLarge">20</sys:Double>
                    <sys:Double x:Key="FontSizeTitle">24</sys:Double>
                    
                    <!-- ===== 精致按钮样式 ===== -->
                    <!-- 主要按钮（计算按钮） - 珊瑚橙渐变 -->
                    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Padding" Value="28,8"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource RadiusMedium}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Height" Value="36"/>
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F97316" Offset="0"/>
                                    <GradientStop Color="#FB923C" Offset="1"/>
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#F97316" BlurRadius="8" ShadowDepth="2" Opacity="0.4" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    
                    <!-- 次要按钮（清空等） - 透明背景+边框 -->
                    <Style x:Key="SecondaryFlatButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                        <Setter Property="Padding" Value="12,6"/>
                        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="{StaticResource RadiusSmall}"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    
                    <!-- 工具栏按钮 -->
                    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    
                    <!-- 优化输入框样式 - 底部线条增强 -->
                    <Style x:Key="CalcInputBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeXLarge}"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Visible"/>
                        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    </Style>
                    
                    <!-- 卡片样式 - 增加阴影和边框 -->
                    <Style x:Key="EnhancedCard" TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.25" Direction="270"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
